# 复制为 .env 后按需修改。.env 不应提交到仓库。

# ---- 演示模式 ----
# true  : 决策走预录制回放，不真实调用模型（答辩/离线演示用）
# false : 正常调用
DEMO_MODE=false
# true  : 把真实调用的结果录制下来，供以后回放
DEMO_RECORD=false

# ---- 数据库 ----
# 默认 data/app.db，SQLite 本地文件
# DATABASE_PATH=./data/app.db

# ---- 前端地址（CORS）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- DeepSeek（P4 接入后才需要）----
# DEEPSEEK_API_KEY=sk-xxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以 GET /models 为准。2026-10-29 实测该账号只开放：
#   deepseek-flash（= DeepSeek-V4.1-Flash，便宜够用，默认）
#   deepseek-v4-pro
# 旧文档里的 deepseek-chat / deepseek-reasoner 已退役，写上去会直接 400。
# DEEPSEEK_MODEL=deepseek-flash
# LLM_TIMEOUT_SEC=15
# 4096 而非 1024：推理 token 与输出共用这个额度。实测种子库那档 prompt 的推理
# token 在 1111~2194 之间 —— 2048 会撞顶，表现是 content 全空（推理吃光额度），
# 4096 下 5/5 成功。这只是上限，不是预购额度，调高不为成功响应多付钱。
# 注意：推理 token 随 records 条数增长，数据变多后可能再次撞顶（见 docs/09 观察项）。
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.2
